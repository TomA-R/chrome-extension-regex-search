{
  "name": "regex-find",
  "description": "Fast, safe regular-expression find-in-page for Chrome",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "wxt build && playwright test",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "coverage": "rm -rf coverage && vitest run --coverage --coverage.include=src/**/*.{ts,tsx} --coverage.reporter=json --coverage.reportsDirectory=coverage/unit && COVERAGE=1 wxt build && COVERAGE=1 playwright test && node scripts/coverage-report.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@preact/preset-vite": "2.10.6",
    "@types/chrome": "0.3.7",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "happy-dom": "21.0.4",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "v8-to-istanbul": "9.3.0",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  },
  "dependencies": {
    "preact": "11.2.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
